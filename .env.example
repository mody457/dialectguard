# Copy to .env for local development. Do not commit .env.
# All values below are optional; the defaults are what the app uses.

# Directory holding config.json, model.safetensors and the tokenizer files.
DIALECTGUARD_MODEL_DIR=models/dialectguard_model

# Reported by /version. Bump when the checkpoint changes.
DIALECTGUARD_MODEL_VERSION=dialectguard-marbertv2-v1

# DEBUG locally, INFO in production.
DIALECTGUARD_LOG_LEVEL=INFO

# Set to true to include raw request text in prediction logs. Off by default
# because request bodies are user content.
DIALECTGUARD_LOG_RAW_TEXT=false

# Injected at build time in environments with no .git directory.
# DIALECTGUARD_GIT_COMMIT=
